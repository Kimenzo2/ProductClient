PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only (never PUBLIC_, never commit) — service_role / sb_secret for privileged Data API / storage / auth.admin
# SUPABASE_SECRET_API_KEY=sb_secret_...
# SUPABASE_SECRET_KEY=sb_secret_...
# Optional fallback:
# PUBLIC_SUPABASE_ANON_KEY=sb_anon_...

# ── Local auth: Supabase dashboard → Authentication → URL Configuration ──
# Dev ports are pinned (vite.config.ts, strictPort), so register these exact
# localhost URLs ONCE and they never drift:
#   Site URL: http://localhost:3000
#   Redirect URLs: http://localhost:3000/** + http://localhost:4100/**
#   (ProductClient dev :3000, P-Landing dev :4100)
# Production redirect URLs (both hosts, both projects):
#   https://auth.productclient.com/** + https://app.productclient.com/**
#   + https://productclient.com/**
#
# ── Zero-auth local flag (dashboard UI dev without signing in) ──
# PUBLIC_DEV_AUTH_BYPASS=1
# Guards pass with no user; pages render on mock data. DEV ONLY — PROD
# builds ignore it unconditionally. Restart `bun run dev` after changing.
