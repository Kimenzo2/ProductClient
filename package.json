{
	"name": "productclient",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/patch-reicon.mjs && vite build",
		"preview": "vite preview",
		"lint": "oxlint .",
		"prepare": "node scripts/patch-sveltekit-css.mjs && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"deploy": "vercel --prod",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@shadcn/lint": "^0.2.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@typescript/native": "npm:typescript@7.0.2",
		"oxlint": "^1.86.0",
		"svelte": "^5.57.1",
		"svelte-5-doctor": "0.5.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.2",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@supabase/ssr": "0.12.7",
		"@supabase/supabase-js": "^2.117.2",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"bits-ui": "^2.19.4",
		"cn": "^0.4.0",
		"components-svelte": "0.1.3",
		"edra": "3.1.3",
		"embla-carousel-svelte": "^8.6.0",
		"open-props": "^1.7.23",
		"reicon-svelte": "^1.0.105",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.31.0",
		"tailwind-variants": "^3.3.1",
		"zod": "^4.6.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
