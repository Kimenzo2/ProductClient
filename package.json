{
	"name": "productclient",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/patch-reicon.mjs && vite build",
		"preview": "vite preview",
		"prepare": "node scripts/patch-sveltekit-css.mjs && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@typescript/native": "npm:typescript@7.0.2",
		"svelte": "^5.57.0",
		"svelte-5-doctor": "0.5.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.112.4",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"bits-ui": "^2.19.0",
		"open-props": "^1.7.23",
		"reicon-svelte": "^1.0.103",
		"sveltekit-superforms": "^2.30.2",
		"zod": "^4.5.4"
	}
